# Copy to .env and adjust. Every variable src/env.ts and src/env-client.ts
# read is listed here; tests/unit/env-example.test.ts keeps the two in step.

NODE_ENV=development

# Runtime connection — PgBouncer from docker-compose.yml (port 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkquisitor?schema=public

# Direct Postgres connection for `prisma migrate` (port 5436). Read by
# prisma.config.ts, not by the app. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/inkquisitor?schema=public
