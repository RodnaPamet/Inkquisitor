# Copy to .env and adjust. Every variable src/env.ts and src/env-client.ts
# read is listed here; tests/unit/env-example.test.ts keeps the two in step.
#
# Everything below DATABASE_URL is optional in development: the defaults
# in the code point at the local docker-compose stack. Production refuses to
# start while a variable it requires is missing (src/lib/startup-checks.ts).

NODE_ENV=development

# Runtime connection — PgBouncer from docker-compose.yml (port 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkquisitor?schema=public

# Direct Postgres connection for `prisma migrate` (port 5436). Read by
# prisma.config.ts, not by the app. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/inkquisitor?schema=public

# ── Public URL ──────────────────────────────────────────────────────
# The origin people reach the product on. Links handed outside the process
# are built from it (src/lib/http/public-base-url.ts).
# APP_URL=http://localhost:3000

# ── Authentication (Phase 0.3) ──────────────────────────────────────
# AUTH_SECRET signs and encrypts the session JWT. REQUIRED in production, at
# least 32 characters: openssl rand -base64 48. Development and test use the
# documented fallback (src/lib/auth/auth-constants.ts), refused in production.
# AUTH_SECRET=
# The origin sign-in callbacks are built on. REQUIRED in production.
# NEXTAUTH_URL=http://localhost:3000
# Google sign-in: set both to show the Google button, neither to hide it.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Breached-password check at sign-up (HIBP range API, k-anonymity, fails
# open). on (default) | off — off for an air-gapped install.
# PASSWORD_BREACH_CHECK=on

# ── Field encryption (Phase 0.3) ────────────────────────────────────
# The master key that wraps every workspace's data key. REQUIRED in
# production, at least 32 characters, never the development fallback:
# openssl rand -base64 48. Development and test use the documented fallback
# (src/lib/security/encryption-constants.ts) with a warning.
# DATA_ENCRYPTION_KEY=

# ── Logging ─────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent (default: debug in
# development, info otherwise).
# LOG_LEVEL=debug

# ── OpenTelemetry (off unless OTEL_ENABLED=true) ────────────────────
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=inkquisitor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Sentry (off unless SENTRY_DSN is set) ───────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Redis — rate limits and the BullMQ job queue ────────────────────
# Development default: redis://localhost:6379 (the compose Redis).
# REQUIRED in production, with a password: redis://:PASSWORD@HOST:6379
# REDIS_URL=redis://localhost:6379

# ── Rate limiting ───────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=0 turns every tier off. Upstash is used only when both
# UPSTASH_REDIS_REST_* are set; otherwise the in-memory store (one budget per
# process). RATE_LIMIT_MODE=memory forces memory.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_MODE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# The reverse proxies in front of the app that append to X-Forwarded-For.
# Every rate limit keys on the entry this many positions from the RIGHT of
# that header (what the nearest trusted proxy saw); entries to its left are
# whatever the client sent. Production behind Caddy: 1 (the default). 0 trusts
# no forwarded header, and every request then shares one budget.
# TRUSTED_PROXY_HOPS=1

# ── File storage ────────────────────────────────────────────────────
# local (default) or s3. S3_BUCKET is required when STORAGE_PROVIDER=s3.
# Production with local storage REQUIRES FILE_STORAGE_ROOT on a persistent
# volume (the development default is under the OS temp directory).
# STORAGE_PROVIDER=local
# FILE_STORAGE_ROOT=/tmp/inkquisitor-uploads
# FILE_MAX_SIZE_BYTES=52428800
# FILE_ALLOWED_MIME=application/pdf,text/plain,text/markdown
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Antivirus scanning ──────────────────────────────────────────────
# strict (default: downloads wait for a clean scan) | permissive | disabled.
# CLAMAV_HOST is required in production unless AV_SCAN_MODE=disabled.
# AV_SCAN_MODE=strict
# CLAMAV_HOST=localhost:3310

# ── Embeddings (the vector store's provider, subphase 2.0) ──────────
# stub (development and test default: deterministic, no network) | tei
# (Text Embeddings Inference, self-hosted INSIDE the deployment: the base URL
# must be a loopback, RFC 1918 or unique-local address, or a name resolving
# only to those). Production refuses stub; with tei it requires the URL, the
# model id exactly as TEI's --model-id names it, and the dimension count.
# The prefixes are the model's query / passage instructions, if it has any.
# EMBEDDING_PROVIDER=stub
# EMBEDDING_TEI_BASE_URL=http://tei:80
# EMBEDDING_TEI_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_TEI_DIMENSIONS=384
# EMBEDDING_TEI_QUERY_PREFIX=
# EMBEDDING_TEI_PASSAGE_PREFIX=

# ── The model layer (Phase 2.1) ─────────────────────────────────────
# The Anthropic API key. Optional: without it every model call is refused
# and the product runs with AI unavailable. Not required in production yet
# (nothing calls a model there before 2.2); 2.2 makes it required.
# ANTHROPIC_API_KEY=
# 1 = the key's Anthropic organization has a zero-data-retention
# arrangement (decision D5). ZDR is enabled per ORGANIZATION by Anthropic's
# account team; no request can ask for it. Production refuses to start with
# ANTHROPIC_API_KEY set and this unset. Confirm the contract before setting it.
# ANTHROPIC_ZDR_CONFIRMED=1
# Must stay unset: the SDK adds it to every request, so the model layer
# refuses to build a client while it is set.
# ANTHROPIC_CUSTOM_HEADERS=
# The global kill switch: 1 refuses every model call, nothing is sent.
# AI_DISABLED=0
# Each workspace's model spend ceiling per UTC calendar month, US dollars.
# Default 25 (a placeholder; the owner may change it).
# AI_MONTHLY_CEILING_USD_DEFAULT=25
# The model each tier runs on (defaults below).
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL_BALANCED=claude-sonnet-5-5
# AI_MODEL_DEEP=claude-opus-5-5

# ── Mail (console sink when SMTP_HOST is unset) ─────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# TLS is required: implicit on 465, STARTTLS on every other port. Only a
# loopback host outside production (a local mail catcher) may speak plain SMTP.
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Inkquisitor <no-reply@localhost>
