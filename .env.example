# Copy to .env and adjust. Every variable src/env.ts and src/env-client.ts
# read is listed here; tests/unit/env-example.test.ts keeps the two in step.
#
# Everything below DATABASE_URL is optional in development: the defaults
# in the code point at the local docker-compose stack. Production refuses to
# start while a variable it requires is missing (src/lib/startup-checks.ts).

NODE_ENV=development

# Runtime connection — PgBouncer from docker-compose.yml (port 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkquisitor?schema=public

# Direct Postgres connection for `prisma migrate` (port 5436). Read by
# prisma.config.ts, not by the app. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/inkquisitor?schema=public

# ── Public URL ──────────────────────────────────────────────────────
# The origin people reach the product on. Links handed outside the process
# are built from it (src/lib/http/public-base-url.ts).
# APP_URL=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent (default: debug in
# development, info otherwise).
# LOG_LEVEL=debug

# ── OpenTelemetry (off unless OTEL_ENABLED=true) ────────────────────
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=inkquisitor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Sentry (off unless SENTRY_DSN is set) ───────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Redis — rate limits and the BullMQ job queue ────────────────────
# Development default: redis://localhost:6379 (the compose Redis).
# REQUIRED in production, with a password: redis://:PASSWORD@HOST:6379
# REDIS_URL=redis://localhost:6379

# ── Rate limiting ───────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=0 turns every tier off. Upstash is used only when both
# UPSTASH_REDIS_REST_* are set; otherwise the in-memory store (one budget per
# process). RATE_LIMIT_MODE=memory forces memory.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_MODE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── File storage ────────────────────────────────────────────────────
# local (default) or s3. S3_BUCKET is required when STORAGE_PROVIDER=s3.
# Production with local storage REQUIRES FILE_STORAGE_ROOT on a persistent
# volume (the development default is under the OS temp directory).
# STORAGE_PROVIDER=local
# FILE_STORAGE_ROOT=/tmp/inkquisitor-uploads
# FILE_MAX_SIZE_BYTES=52428800
# FILE_ALLOWED_MIME=application/pdf,text/plain,text/markdown
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Antivirus scanning ──────────────────────────────────────────────
# strict (default: downloads wait for a clean scan) | permissive | disabled.
# CLAMAV_HOST is required in production unless AV_SCAN_MODE=disabled.
# AV_SCAN_MODE=strict
# CLAMAV_HOST=localhost:3310

# ── Mail (console sink when SMTP_HOST is unset) ─────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# TLS is required: implicit on 465, STARTTLS on every other port. Only a
# loopback host outside production (a local mail catcher) may speak plain SMTP.
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Inkquisitor <no-reply@localhost>
