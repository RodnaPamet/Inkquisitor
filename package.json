{
  "name": "inkquisitor",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "build:check": "node scripts/check-build.js",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui/tsconfig.json",
    "test": "jest --selectProjects unit rendered",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:load": "BIBLE_LOAD_ELEMENTS=2000 BIBLE_LOAD_VERSIONS=20000 jest --selectProjects integration --runInBand tests/integration/bible-load.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prepare": "husky",
    "secret-scan": "bash scripts/detect-secrets.sh",
    "docs:build": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@sentry/nextjs": "^11.14.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@visx/axis": "^4.0.0",
    "@visx/clip-path": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/text": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.5",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.72.0",
    "motion": "^13.5.1",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "next-intl": "^4.15.1",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.3",
    "sanitize-html": "^2.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.4",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bcrypt": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-array": "^3.2.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "js-yaml": "^5.5.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer",
      "next": "$next"
    }
  }
}
