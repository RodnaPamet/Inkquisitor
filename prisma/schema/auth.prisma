// ─────────────────────────────────────────────────────────────────
//  Identity: people, how they sign in, and their sessions (Phase 0.3).
//
//  None of these tables is workspace-scoped: a person exists before
//  and across workspaces, so they carry no `workspaceId` and no
//  row-level security (they are listed in `GLOBAL_MODELS`,
//  src/lib/db/rls-tripwire.ts). They are reached on the plain client by
//  sign-in (`src/lib/auth/**`, `src/auth.ts`), sign-up
//  (`src/app-layer/usecases/sign-up.ts`) and the session tracker
//  (`src/lib/security/session-tracker.ts`); app_user holds no grant on
//  Account, VerificationToken or UserSession, and on User only SELECT
//  of id, name and email (member lists) — no passwordHash, no write.
//  Workspace-scoped models live in workspace.prisma, audit.prisma and bible.prisma.
// ─────────────────────────────────────────────────────────────────

/// A person. `email` is stored lower-cased and trimmed; it is the
/// sign-in identifier and the account-linking key for Google.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  /// Set when a provider that vouches for the address (Google with
  /// `email_verified`) signed this person in. NULL for a password-only
  /// sign-up, whose address nobody has proved.
  emailVerified  DateTime?
  name           String?
  image          String?
  /// bcrypt over sha256(password), `src/lib/auth/passwords.ts`. NULL for
  /// a Google-only account.
  passwordHash   String?
  /// Bumped to sign out every session of the user at once; a JWT minted
  /// under a lower value is refused (`SessionRevokedError`).
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          UserSession[]
  memberships       WorkspaceMembership[]
  /// Bible versions this person saved; the link is cleared (and the version
  /// kept) when the person is deleted.
  bibleVersions     BibleEntryVersion[]
  /// Interviews this person started, and answers they gave (Phase 2.2); both
  /// links are cleared (and the rows kept) when the person is deleted.
  interviewSessions InterviewSession[]
  interviewAnswers  Answer[]
}

/// An OAuth identity linked to a user (Google). No provider token is
/// stored: nothing in the product calls Google after sign-in.
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Single-use tokens for email verification (the NextAuth shape). No
/// flow writes it yet; it exists so the email-verification step lands
/// without a schema change. A token is stored as its SHA-256, never raw.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// The operational record of one signed-in browser: one row per sign-in,
/// verified on every JWT pass. A revoked or expired row makes the `jwt`
/// callback throw, so `getServerSession` returns null (src/auth.ts).
model UserSession {
  id            String    @id @default(cuid())
  /// 128-bit random id carried on the JWT as `userSessionId`.
  sessionId     String    @unique
  userId        String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
