// ─────────────────────────────────────────────────────────────────
//  Workspaces and memberships (Phase 0.3, owner decision D4).
//
//  EVERY MODEL WITH A `workspaceId` IS WORKSPACE-SCOPED: its table has
//  FORCE ROW LEVEL SECURITY, a `workspace_isolation` policy (USING and
//  WITH CHECK on `app.workspace_id`) and the `superuser_bypass` policy,
//  and it is reached through `runInWorkspaceContext`
//  (src/lib/db/rls-middleware.ts). `Workspace` itself is scoped on its
//  own `id`. tests/guards/rls-migration-coverage.test.ts and
//  tests/integration/rls-coverage.test.ts fail for a scoped model
//  without the policy. See docs/rls-workspace-isolation.md.
// ─────────────────────────────────────────────────────────────────

/// One author's workspace. Created with its OWNER membership and its
/// data key in one transaction (`createWorkspaceWithOwner`).
model Workspace {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  /// The workspace's data-encryption key, wrapped under the master KEK
  /// (DATA_ENCRYPTION_KEY). `src/lib/security/workspace-key-manager.ts`.
  encryptedDek         String?
  /// The previous wrapped DEK while a key rotation is in flight; NULL
  /// otherwise. A CHECK refuses it equal to `encryptedDek`.
  previousEncryptedDek String?
  /// Phase 5.H-a: when an OWNER asked for the whole workspace to be deleted
  /// (UTC, the database's clock for app_user: trigger
  /// `workspace_deleted_at_is_now`). A deleted workspace is closed to every
  /// member and to the background jobs; an OWNER may restore it for
  /// `WORKSPACE_RESTORE_DAYS` (30), then the daily `workspace-purge` job
  /// deletes it, everything it holds and its stored objects. NULL is live.
  deletedAt            DateTime?
  /// Who asked for the deletion; NULL once that account is deleted.
  deletedById          String?
  /// The OWNER who also asked for their ACCOUNT to be deleted with the
  /// workspace (only when it was their only workspace). The purge deletes that
  /// account too, unless they belong to another workspace by then.
  purgeAccountOfId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  deletedBy      User? @relation("WorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  purgeAccountOf User? @relation("WorkspacePurgeAccountOf", fields: [purgeAccountOfId], references: [id], onDelete: SetNull)

  memberships       WorkspaceMembership[]
  books             Book[]
  vectorEmbeddings  VectorEmbedding[]
  aiCalls           AiCallLog[]
  aiSpendMonths     AiSpendMonth[]
  aiReservations    AiSpendReservation[]
  interviewDefaults WorkspaceInterviewDefaults?
  /// Phase 4.0: the workspace's source libraries (its series library, and every book's).
  sourceLibraries   SourceLibrary[]
  /// Phase 4.1: the vectors waiting to be (re)embedded.
  embeddingTasks    EmbeddingTask[]

  /// The purge's scan (5.H-a): workspaces deleted at or before the cutoff.
  @@index([deletedAt])
  @@index([deletedById])
  @@index([purgeAccountOfId])
}

/// A person's role in a workspace. One per (workspace, user).
model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}
