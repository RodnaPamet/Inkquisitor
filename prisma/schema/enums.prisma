// ─────────────────────────────────────────────────────────────────
//  Shared enums. Every enum in the schema lives in this file, so a
//  domain file never has to import from another domain file to name
//  one. See prisma/schema/README.md.
// ─────────────────────────────────────────────────────────────────

/// A member's role in a workspace (owner decision D4). The permission
/// set each role grants is `src/lib/permissions.ts`.
enum WorkspaceRole {
  OWNER
  EDITOR
  READER
}

/// The kinds of bible element (Phase 1.1). Closed: the field template of each
/// lives in `src/lib/bible/templates/<kind>.json`, and the order here is the
/// order of `BIBLE_KINDS` (`src/lib/bible/kinds.ts`), which decides which
/// template declares a relation between two kinds.
enum BibleElementKind {
  PREMISE
  PLOT
  CHARACTER
  SETTING
  THEME
  MOOD
  TEXTURE
  STYLE
  POV
  WORLD_RULE
  TIMELINE_EVENT
  FACTION
  OBJECT
  RESEARCH
  CUSTOM
}

/// How settled the author considers an element.
enum BibleElementStatus {
  DRAFT
  IN_PROGRESS
  SETTLED
}

/// Where a book stands on the way to publication.
enum BookStage {
  CONCEPT
  PLANNING
  DRAFTING
  REVISING
  PUBLISHING
}

/// What produced a bible version: the author by hand, an interview the
/// author accepted (Phase 2), or an import (Phase 1.3).
enum BibleVersionSource {
  MANUAL
  INTERVIEW
  IMPORT
}

/// How a model call ended (Phase 2.1); one per `AiCallLog` row. Mirrored by
/// `AI_CALL_OUTCOMES` in src/lib/ai/errors.ts.
enum AiCallOutcome {
  OK
  REPAIRED
  INVALID_OUTPUT
  REFUSED_GUARD
  CEILING
  KILLED
  PROVIDER_ERROR
  TIMEOUT
  ABORTED
}

/// The model tier a call named (Phase 2.1, src/lib/ai/tiers.ts).
enum AiModelTier {
  FAST
  BALANCED
  DEEP
}
