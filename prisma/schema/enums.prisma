// ─────────────────────────────────────────────────────────────────
//  Shared enums. Every enum in the schema lives in this file, so a
//  domain file never has to import from another domain file to name
//  one. See prisma/schema/README.md.
// ─────────────────────────────────────────────────────────────────

/// A member's role in a workspace (owner decision D4). The permission
/// set each role grants is `src/lib/permissions.ts`.
enum WorkspaceRole {
  OWNER
  EDITOR
  READER
}

/// The kinds of bible element (Phase 1.1). Closed: the field template of each
/// lives in `src/lib/bible/templates/<kind>.json`, and the order here is the
/// order of `BIBLE_KINDS` (`src/lib/bible/kinds.ts`), which decides which
/// template declares a relation between two kinds.
enum BibleElementKind {
  PREMISE
  PLOT
  /// Phase 3.2 (decision D22): one beat of a plotline, a card on the plot board.
  PLOT_BEAT
  CHARACTER
  SETTING
  THEME
  MOOD
  TEXTURE
  STYLE
  POV
  WORLD_RULE
  TIMELINE_EVENT
  FACTION
  OBJECT
  RESEARCH
  CUSTOM
}

/// How settled the author considers an element.
enum BibleElementStatus {
  DRAFT
  IN_PROGRESS
  SETTLED
}

/// Where a book stands on the way to publication.
enum BookStage {
  CONCEPT
  PLANNING
  DRAFTING
  REVISING
  PUBLISHING
}

/// What produced a bible version: the author by hand, an interview the
/// author accepted (Phase 2), an import (Phase 1.3), or research the author
/// accepted (Phase 2.6).
enum BibleVersionSource {
  MANUAL
  INTERVIEW
  IMPORT
  RESEARCH
}

/// What an interview covers (Phase 2.2): one element, every element of one
/// kind, or the whole book ("Grill me").
enum InterviewScope {
  ELEMENT
  KIND
  BOOK
  /// Phase 3.3 ("Grill this"): the elements and relations selected on a story map.
  SELECTION
  /// Phase 3.3 ("What happens between these?"): a beat not yet created, between two neighbouring beats.
  BETWEEN
}

/// Where an interview stands. ACTIVE asks rounds; PAUSED stopped for a reason
/// that can clear (a model failure, a budget) and resumes with the next
/// round; COMPLETED ran out of things to ask or of rounds; STOPPED was ended
/// by the author. `stopReason` says which.
enum InterviewStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

/// Why an interview stopped (src/lib/interview/stop.ts). Every stop is
/// recorded with one, so a session never ends without saying why.
enum InterviewStopReason {
  FRONTIER_EMPTY
  NOTHING_AT_DEPTH
  ROUND_BUDGET
  TOKEN_BUDGET
  WORKSPACE_CEILING
  KILL_SWITCH
  AUTHOR_STOPPED
  PROVIDER_FAILURE
  NO_ACCEPTABLE_QUESTION
  GUARD_REFUSED
  /// A pack the session pinned changed since it started (Phase 2.3).
  PACK_CHANGED
}

/// A round's life: GENERATING while its questions are being made (a claim:
/// one at a time per session), OPEN while the author answers, CLOSED once
/// every question has a status, FAILED when generation produced nothing.
enum InterviewRoundStatus {
  GENERATING
  OPEN
  CLOSED
  FAILED
}

/// The five shapes a question takes (content formats v1, section 1.7).
enum QuestionKind {
  OPEN
  CHOICE
  EITHER_OR
  SCENARIO
  SCALE
}

/// FRONTIER asks for an open field; CHALLENGE quotes a stored value and asks
/// the author to test it, never for it afresh.
enum QuestionMode {
  FRONTIER
  CHALLENGE
}

/// Who worded a question: the model, or the field's craft pack when no
/// generated question for it survived validation and deduplication, or the
/// model again when the author asked "Ask me this differently" (REPHRASE,
/// Phase 2.4: the question replaces another, `Question.replacesQuestionId`).
enum QuestionOrigin {
  MODEL
  PACK_FALLBACK
  REPHRASE
}

/// What the author did with a question.
enum AnswerStatus {
  ANSWERED
  SKIPPED
  DECIDE_LATER
}

/// What a reconcile step proposes for one field (Phase 2.5; the mem0
/// reconciliation pattern, Apache-2.0): ADD a value to an empty field, UPDATE
/// a filled one, REMOVE a filled one's value. NO_CHANGE is the fourth answer
/// a reconcile step may give, and it is never stored: it writes nothing.
enum EnrichmentOperation {
  ADD
  UPDATE
  REMOVE
}

/// A proposal changes one FIELD of an element, or names a NEW_ELEMENT an
/// answer mentions that the bible lacks (created only when the author accepts).
enum EnrichmentProposalKind {
  FIELD
  NEW_ELEMENT
  /// Phase 3.3 (D24): a change to one field of a relation.
  RELATION_FIELD
  /// Phase 3.3 (D24): a new relation between two elements (or a new element of the same run).
  NEW_RELATION
}

/// Where a proposal stands. PENDING awaits the author; ACCEPTED and
/// EDITED_ACCEPTED wrote a version (the latter with the author's edit);
/// REJECTED wrote nothing; SUPERSEDED was overtaken by another proposal for
/// the same field that the author accepted.
enum EnrichmentProposalStatus {
  PENDING
  ACCEPTED
  EDITED_ACCEPTED
  REJECTED
  SUPERSEDED
}

/// A round's reconcile run (Phase 2.5): RUNNING while its model call is out (a
/// claim: one at a time per round); DONE once its proposals are stored (none
/// is a valid answer); FAILED when the call failed (re-runnable); REFUSED when
/// it was not run at all (no model call can be made, or the reconcile prompt
/// has no evaluation record this deployment accepts: D11).
enum ReconcileRunStatus {
  RUNNING
  DONE
  FAILED
  REFUSED
}

/// How a model call ended (Phase 2.1); one per `AiCallLog` row. Mirrored by
/// `AI_CALL_OUTCOMES` in src/lib/ai/errors.ts.
enum AiCallOutcome {
  OK
  REPAIRED
  INVALID_OUTPUT
  REFUSED_GUARD
  CEILING
  KILLED
  PROVIDER_ERROR
  TIMEOUT
  ABORTED
}

/// The model tier a call named (Phase 2.1, src/lib/ai/tiers.ts).
enum AiModelTier {
  FAST
  BALANCED
  DEEP
}

/// How deep a research brief goes (Phase 2.6): it sets the run's step and
/// spend budget (`src/lib/research/vocabulary.ts`, `DEPTH_BUDGETS`).
enum ResearchDepth {
  QUICK
  STANDARD
  THOROUGH
}

/// Where a research brief stands: never run, waiting in the queue, running,
/// or how its latest run ended (Phase 2.6).
enum ResearchBriefStatus {
  READY
  QUEUED
  RUNNING
  DONE
  FAILED
  REFUSED
}

/// A research run's state (Phase 2.6). A run is a background job, one per
/// brief at a time: QUEUED until the worker claims it.
enum ResearchRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  REFUSED
}

/// How sure a finding is, as the agent states it and code bounds it (2.6).
enum ResearchConfidence {
  LOW
  MEDIUM
  HIGH
}

/// What a research citation points at: a fetched web page, or a file the
/// author attached to the brief (2.6).
enum ResearchCitationKind {
  URL
  UPLOAD
}

/// What a research proposal does (2.6): add to an empty field, update a
/// filled one, or propose a new element.
enum ResearchProposalOperation {
  ADD
  UPDATE
  NEW_ELEMENT
}

/// The three story maps a book has, one of each (Phase 3.1, decision D18):
/// the relationship map, the plot board and the timeline.
enum StoryMapKind {
  RELATIONSHIP
  PLOT
  TIMELINE
}

/// Whose library a source is in (Phase 4.0, D26): a book's, or the workspace's series library.
enum SourceLibraryScope {
  BOOK
  SERIES
}

/// What an uploaded source was read as (Phase 4.0, D26), sniffed from its bytes.
enum SourceFormat {
  DOCX
  MARKDOWN
  TXT
  EPUB
  PDF
}

/// Where a source's ingestion stands (Phase 4.0). ESTIMATED: read and chunked,
/// its cost shown, waiting for the author to confirm. STOPPED: paused with a
/// named reason (the ceiling, the kill switch, its budget), resumable.
enum SourceStatus {
  ESTIMATED
  QUEUED
  RUNNING
  STOPPED
  DONE
  FAILED
}

/// A fact's decision (Phase 4.0, D23): only a CONFIRMED fact counts as answered.
enum StoryFactStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Where a fact comes from (Phase 4.0; 4.1, D27): a passage of an uploaded
/// source (confirmed by the author), or an accepted bible version — an
/// element's or a relation's — whose facts count at once. An answer reaches
/// the fact layer through the version that accepted it (its
/// `sourceAnswerIds`), never on its own (rule 1).
enum StoryFactSourceKind {
  SOURCE_CHUNK
  BIBLE_VERSION
  RELATION_VERSION
}
