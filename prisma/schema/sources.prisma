// ─────────────────────────────────────────────────────────────────
//  The source library (Phase 4.0, decisions D23 and D26): the author's own
//  manuscripts, drafts, notes and earlier books, read into chunks, embedded,
//  and mined for StoryFacts the author confirms one by one.
//
//  A LIBRARY is a book's (scope BOOK, `bookId` set) or the workspace's series
//  library (scope SERIES, no book; one per workspace, a partial unique index
//  in the migration). A book OPTS IN to the series sources it draws on
//  (`BookSeriesSource`), and may OVERRIDE an inherited fact for itself
//  (`StoryFactOverride`): the book's own answer wins for that book, the series
//  fact stays as it is for every other.
//
//  NO FILE IS STORED (the 1.3 rule): an upload is read, virus-scanned and
//  parsed in the request, and only its extracted, encrypted chunks are kept.
//  Re-uploading a changed file under the same name is a NEW `Source` that
//  supersedes the old one (`supersedesId`, `version`); the old one keeps its
//  facts until the author removes it, and a fact of the new one quoting the
//  same passage for the same claim carries the old decision over
//  (`carriedFromFactId`). The same content twice in one library is refused.
//
//  NOTHING HERE CHANGES THE BIBLE (rule 1). A fact is PENDING until the author
//  confirms or rejects it; only a CONFIRMED fact counts as answered for the
//  question engine (rule 5, D23), and only through the explicit predicate →
//  field table in `src/lib/sources/vocabulary.ts`.
//
//  EVERY MODEL HERE IS WORKSPACE-SCOPED (FORCE RLS, `workspace_isolation`,
//  `superuser_bypass`), and AUTHOR TEXT IS ENCRYPTED AT REST
//  (`src/lib/security/encrypted-fields.ts`): a source's file name, a chunk's
//  text and heading path, a fact's subject, object, statement, quote and
//  story times, an override's text. A source holds counts, codes and amounts.
//
//  `StoryFact` is the 4.1 fact model, defined here (D23): 4.1 extends it to
//  facts drawn from answers and accepted bible versions by adding source kinds
//  and their columns, never a second fact table.
// ─────────────────────────────────────────────────────────────────

/// A book's library, or the workspace's series library.
model SourceLibrary {
  id          String             @id @default(cuid())
  workspaceId String
  scope       SourceLibraryScope
  /// BOOK: the book (CHECK: set exactly for BOOK). SERIES: NULL.
  bookId      String?
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book      Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sources   Source[]

  @@unique([workspaceId, id])
  /// One library per book (a SERIES row's NULL book is distinct; the series
  /// library's own uniqueness is a partial index in the migration).
  @@unique([workspaceId, bookId])
  @@index([bookId])
}

/// One uploaded file, kept as its extracted chunks, and its ingestion.
model Source {
  id               String       @id @default(cuid())
  workspaceId      String
  libraryId        String
  /// The file's name as uploaded (encrypted, sanitised).
  filename         String
  format           SourceFormat
  /// The upload's size in bytes, before extraction.
  byteLength       Int
  /// The keyed hash (`workspaceSubkey`) of the extracted text: the same content twice in one library is refused.
  contentHash      String
  /// 1 for a first upload; the superseded source's + 1 for a changed re-upload of the same file name.
  version          Int          @default(1)
  /// The source this one replaced (a changed file under the same name), NULL otherwise. No foreign key: removing the old one keeps the new.
  supersedesId     String?
  status           SourceStatus @default(ESTIMATED)
  /// How the last ingestion ended or paused, a code (CHECK; `SOURCE_OUTCOMES`).
  outcome          String?
  chunkCount       Int
  /// Chunks whose facts have been extracted (the job's resumable cursor counts them).
  chunksDone       Int          @default(0)
  factCount        Int          @default(0)
  /// What extraction of every chunk is expected to cost, and at most costs, micro-US-dollars.
  estimateMicroUsd BigInt
  worstCaseMicroUsd BigInt
  /// The spend the author confirmed for the current ingestion (the BUDGET stop), micro-US-dollars.
  budgetMicroUsd   BigInt       @default(0)
  /// What extraction has cost so far, micro-US-dollars.
  spentMicroUsd    BigInt       @default(0)
  /// Counts and codes only (refusals by code, AiCallLog ids). Never text.
  metrics          Json?
  /// The extraction prompt's version (rule 9), set when ingestion is dispatched.
  promptVersion    String?
  /// Who uploaded it; NULL once that person is deleted.
  requestedById    String?
  createdAt        DateTime     @default(now())
  /// When the current ingestion was claimed (QUEUED → RUNNING). It is also the claim's identity: a worker writes only while the row still names its own claim.
  startedAt        DateTime?
  /// The ingestion's last sign of life: set when it is queued and claimed, and on every step it takes. A live row whose heartbeat is older than `STALE_INGEST_MS` reads CLAIM_EXPIRED.
  heartbeatAt      DateTime?
  finishedAt       DateTime?

  library     SourceLibrary @relation(fields: [workspaceId, libraryId], references: [workspaceId, id], onDelete: Cascade)
  requestedBy User?         @relation("SourceRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  chunks      SourceChunk[]
  facts       StoryFact[]
  optIns      BookSeriesSource[]

  @@unique([workspaceId, id])
  /// A library's sources, newest first (the Sources and Series pages).
  @@index([workspaceId, libraryId, createdAt])
  @@index([requestedById])
}

/// A passage of a source: about 1–2k tokens, cut along chapters and scenes.
model SourceChunk {
  id            String    @id @default(cuid())
  workspaceId   String
  sourceId      String
  /// Its place in the source, 0-based.
  position      Int
  /// The chapter and scene headings above it, a JSON array of strings (encrypted), or NULL.
  headingPath   String?
  /// The passage (encrypted, sanitised). The span offsets of every fact refer to it.
  text          String
  /// Where it starts and ends in the source's extracted text, in characters.
  startOffset   Int
  endOffset     Int
  /// Its length in tokens, estimated from its characters (the cost estimate's input).
  tokenEstimate Int
  /// When its facts were extracted (the job's cursor); NULL until then.
  extractedAt   DateTime?
  /// Phase 4.1 (#57 item 2): why the chunk can never be read (it is marked read so the rest completes): REPEATS_PROMPT (CHECK).
  unreadableReason String?
  createdAt     DateTime  @default(now())

  source Source      @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  facts  StoryFact[]

  @@unique([workspaceId, id])
  /// A source's chunks in order (and one chunk a position).
  @@unique([workspaceId, sourceId, position])
}

/// A fact about the story (Phase 4.0; extended in 4.1, D27): drawn from a
/// source passage and waiting for the author (rule 1, D23), or drawn from an
/// accepted bible version, where it counts at once.
///
/// ONE TABLE, THREE KINDS (CHECK `StoryFact_kind_columns`):
///   SOURCE_CHUNK      `sourceId`, `chunkId`; PENDING until decided; not automatic.
///   BIBLE_VERSION     `bookId`, `elementId`, `bibleVersionId`, `dedupeKey`; CONFIRMED and automatic.
///   RELATION_VERSION  `bookId`, `relationId`, `relationVersionId`, `dedupeKey`; CONFIRMED and automatic.
///
/// A bible fact goes with its element or relation (cascade); its version is
/// append-only and goes only with its book. ONE LIVE FACT PER CLAIM: a later
/// version restating a live bible fact adds a provenance row
/// (`StoryFactProvenance`), never a second fact (the partial unique index
/// `StoryFact_one_live_claim`). A live fact is never retired silently: an
/// older fact a newer one contradicts is PROPOSED for invalidation
/// (`StoryFactProposal`) and stays live until the author decides; only that
/// decision sets `supersededAt` and `invalidatedByFactId`, once.
model StoryFact {
  id               String              @id @default(cuid())
  workspaceId      String
  sourceKind       StoryFactSourceKind @default(SOURCE_CHUNK)
  /// SOURCE_CHUNK: the source and its passage. NULL for a bible fact.
  sourceId         String?
  chunkId          String?
  /// BIBLE_VERSION / RELATION_VERSION: the book, and the element or relation the version is of.
  bookId           String?
  elementId        String?
  relationId       String?
  /// The accepted version the fact was drawn from (BIBLE_VERSION / RELATION_VERSION).
  bibleVersionId   String?
  relationVersionId String?
  /// Drawn by the product with no decision of the author's: a bible fact (D27). Its source kind says what.
  automatic        Boolean             @default(false)
  /// A bible fact's claim, keyed (`workspaceSubkey`, never a plain digest of author text): one live fact per claim in a book.
  dedupeKey        String?
  /// Its place among its passage's (or its extraction's) facts.
  position         Int
  /// Who or what it is about, as the source names it (encrypted).
  subjectName      String
  /// The bible element it is about, when linked (a book library's fact whose subject the book names exactly once; a bible fact's subject); NULL otherwise.
  subjectElementId String?
  /// What is stated, a code from the closed list (CHECK; `FACT_PREDICATES`).
  predicate        String
  /// The element it relates the subject to, when linked; NULL otherwise.
  objectElementId  String?
  /// The object as the source states it (encrypted), or NULL.
  objectLiteral    String?
  /// The fact as one plain sentence (encrypted).
  statement        String
  /// The exact words it rests on (encrypted), and where they are: in the chunk's text, or in the version's rendered entry (verified by code).
  quote            String
  quoteStart       Int
  quoteEnd         Int
  /// When in the story it holds, as the source says (encrypted), or NULL.
  storyTimeFrom    String?
  storyTimeTo      String?
  /// When it was stated (extracted).
  statedAt         DateTime            @default(now())
  /// When the author invalidated it (a proposal decided INVALIDATED); NULL while it stands. Set once.
  supersededAt     DateTime?
  /// The newer fact that invalidated it (set with `supersededAt`; NULL again only if that fact goes).
  invalidatedByFactId String?
  status           StoryFactStatus     @default(PENDING)
  /// What the author is warned of (D14 applied): POSSIBLE_INSTRUCTION.
  flags            String[]            @default([])
  decidedById      String?
  decidedAt        DateTime?
  /// The superseded source's fact whose decision this one carried over.
  carriedFromFactId String?
  createdAt        DateTime            @default(now())

  source          Source?               @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)
  chunk           SourceChunk?          @relation(fields: [workspaceId, chunkId], references: [workspaceId, id], onDelete: Cascade)
  book            Book?                 @relation("StoryFactBook", fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  element         BibleElement?         @relation("StoryFactElement", fields: [workspaceId, elementId], references: [workspaceId, id], onDelete: Cascade)
  relation        BibleRelation?        @relation(fields: [workspaceId, relationId], references: [workspaceId, id], onDelete: Cascade)
  bibleVersion    BibleEntryVersion?    @relation(fields: [bibleVersionId], references: [id], onDelete: Cascade)
  relationVersion BibleRelationVersion? @relation(fields: [relationVersionId], references: [id], onDelete: Cascade)
  subjectElement  BibleElement?         @relation("StoryFactSubject", fields: [subjectElementId], references: [id], onDelete: SetNull)
  objectElement   BibleElement?         @relation("StoryFactObject", fields: [objectElementId], references: [id], onDelete: SetNull)
  decidedBy       User?                 @relation("StoryFactDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  invalidatedBy   StoryFact?            @relation("StoryFactInvalidatedBy", fields: [invalidatedByFactId], references: [id], onDelete: SetNull)
  invalidated     StoryFact[]           @relation("StoryFactInvalidatedBy")
  overrides       StoryFactOverride[]
  provenance      StoryFactProvenance[]
  proposals       StoryFactProposal[]   @relation("StoryFactProposalOlder")
  proposalsAsNewer StoryFactProposal[]  @relation("StoryFactProposalNewer")

  @@unique([workspaceId, id])
  /// A source's facts by status, in chunk order (the Facts page).
  @@index([workspaceId, sourceId, status, chunkId, position])
  /// A chunk's facts.
  @@index([workspaceId, chunkId])
  /// Phase 4.1: a book's bible facts about one element, live first (the frontier's check, the retriever, an extraction's resolve).
  @@index([workspaceId, bookId, elementId, supersededAt])
  /// Phase 4.1: a relation's facts.
  @@index([workspaceId, relationId])
  /// Phase 4.1: an element's facts by its foreign key (the cascade), and a book's live facts about some elements (the frontier's check, the retriever).
  @@index([workspaceId, elementId])
  @@index([workspaceId, bookId, subjectElementId])
  @@index([subjectElementId])
  @@index([objectElementId])
  @@index([decidedById])
  @@index([bibleVersionId])
  @@index([relationVersionId])
  @@index([invalidatedByFactId])
}

/// A later accepted version restating a live bible fact (Phase 4.1, D27):
/// the fact is not written twice, its provenance is. Ids only; append-only.
model StoryFactProvenance {
  id                String              @id @default(cuid())
  workspaceId       String
  factId            String
  sourceKind        StoryFactSourceKind
  bibleVersionId    String?
  relationVersionId String?
  createdAt         DateTime            @default(now())

  fact            StoryFact             @relation(fields: [workspaceId, factId], references: [workspaceId, id], onDelete: Cascade)
  bibleVersion    BibleEntryVersion?    @relation(fields: [bibleVersionId], references: [id], onDelete: Cascade)
  relationVersion BibleRelationVersion? @relation(fields: [relationVersionId], references: [id], onDelete: Cascade)

  /// One provenance row per fact and version (an extraction run twice writes nothing).
  @@unique([factId, bibleVersionId])
  @@unique([factId, relationVersionId])
  /// A fact's provenance.
  @@index([workspaceId, factId])
  @@index([bibleVersionId])
  @@index([relationVersionId])
}

/// A live fact proposed for invalidation (Phase 4.1, D27): never resolved
/// silently. Both facts stay live until the author decides: INVALIDATED (the
/// older fact is superseded by the newer), KEPT (both true), or REJECTED (not
/// a contradiction). Minimal on purpose: 4.2's continuity checks extend it.
/// Ids and codes only. One proposal per pair, ever (a partial-free unique
/// index over the pair, NULLS NOT DISTINCT, in the migration): a pair the
/// author decided is never asked again.
model StoryFactProposal {
  id           String    @id @default(cuid())
  workspaceId  String
  bookId       String
  /// The older, live fact proposed for invalidation.
  factId       String
  /// The newer fact that contradicts it; NULL for NO_LONGER_STATED (its entry no longer says it).
  newerFactId  String?
  /// CONTRADICTED | NO_LONGER_STATED (CHECK).
  reason       String
  /// Who saw it: RULE (code, the same single-valued predicate) | MODEL (the extraction's own judgement, checked) | TEXT (the quote is gone from the entry) (CHECK).
  basis        String
  /// PENDING | INVALIDATED | KEPT | REJECTED (CHECK).
  status       String    @default("PENDING")
  /// The extraction that raised it.
  extractionId String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  book      Book       @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  fact      StoryFact  @relation("StoryFactProposalOlder", fields: [workspaceId, factId], references: [workspaceId, id], onDelete: Cascade)
  newerFact StoryFact? @relation("StoryFactProposalNewer", fields: [workspaceId, newerFactId], references: [workspaceId, id], onDelete: Cascade)
  decidedBy User?      @relation("StoryFactProposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  /// A book's proposals by status, newest first (the Facts page).
  @@index([workspaceId, bookId, status, createdAt])
  @@index([workspaceId, factId])
  @@index([workspaceId, newerFactId])
  @@index([decidedById])
}

/// THE FACT EXTRACTION OUTBOX (Phase 4.1, D27): one row per accepted bible
/// version, element or relation, written IN THE VERSION'S TRANSACTION by a
/// trigger (a rolled-back save writes none). The minutely `fact-layer-dispatch`
/// job enqueues a `bible-facts` job for each due row (payload ids only); the
/// job extracts, resolves and records its outcome here. Idempotent: a DONE or
/// SKIPPED row is never run again. Counts and codes only.
model BibleFactExtraction {
  id                String    @id @default(cuid())
  workspaceId       String
  bookId            String
  /// BIBLE_VERSION | RELATION_VERSION (CHECK; set with exactly its version and subject).
  kind              String
  /// The element or relation the version is of (no foreign key: the row outlives a deleted subject, and is then SKIPPED).
  elementId         String?
  relationId        String?
  bibleVersionId    String?   @unique
  relationVersionId String?   @unique
  /// PENDING | QUEUED | RUNNING | DONE | SKIPPED | STOPPED | FAILED (CHECK).
  status            String    @default("PENDING")
  /// How it ended or paused, a code (CHECK; `FACT_EXTRACTION_OUTCOMES`).
  outcome           String?
  attempts          Int       @default(0)
  /// A STOPPED row is dispatched again no earlier than this.
  nextAttemptAt     DateTime?
  factsAdded        Int       @default(0)
  provenanceAdded   Int       @default(0)
  proposalsRaised   Int       @default(0)
  costMicroUsd      BigInt    @default(0)
  promptVersion     String?
  /// Counts and codes only (refusals by code, AiCallLog ids). Never text.
  metrics           Json?
  createdAt         DateTime  @default(now())
  /// When it was queued, and claimed (the claim's identity, as a source's `startedAt`).
  queuedAt          DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?

  book            Book                  @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  bibleVersion    BibleEntryVersion?    @relation(fields: [bibleVersionId], references: [id], onDelete: Cascade)
  relationVersion BibleRelationVersion? @relation(fields: [relationVersionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  /// The dispatcher's scan across workspaces: due rows by status and time.
  @@index([status, createdAt])
  /// An element's extractions (its baseline: the newest DONE one).
  @@index([workspaceId, elementId, status, createdAt])
  @@index([workspaceId, relationId, status, createdAt])
  /// A book's extractions, newest first.
  @@index([workspaceId, bookId, createdAt])
}

/// A source row whose vector is due (Phase 4.1, D8): an element (its
/// versions), a fact or an ANSWERED answer, written by trigger with the row.
/// The minutely dispatcher embeds what it names, as the row stands then,
/// through the 2.0 store, and deletes the task. Ids only.
model EmbeddingTask {
  id          String   @id @default(cuid())
  workspaceId String
  /// BibleElement | StoryFact | Answer (CHECK).
  sourceModel String
  sourceId    String
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// One task per source row (a repeat while it waits is the same task).
  @@unique([workspaceId, sourceModel, sourceId])
  /// The dispatcher's scan across workspaces, oldest first.
  @@index([createdAt])
  /// A workspace's tasks, oldest first.
  @@index([workspaceId, createdAt])
}

/// A book drawing on one of the series library's sources (D26: per-book opt-in).
model BookSeriesSource {
  workspaceId String
  bookId      String
  sourceId    String
  createdAt   DateTime @default(now())

  book   Book   @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  source Source @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)

  @@id([bookId, sourceId])
  /// A book's opted-in series sources.
  @@index([workspaceId, bookId])
  @@index([workspaceId, sourceId])
}

/// A book's own answer in place of an inherited series fact, for that book only (D26).
model StoryFactOverride {
  id          String   @id @default(cuid())
  workspaceId String
  bookId      String
  factId      String
  /// The book's own answer (encrypted, sanitised).
  text        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book      Book      @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  fact      StoryFact @relation(fields: [workspaceId, factId], references: [workspaceId, id], onDelete: Cascade)
  createdBy User?     @relation("StoryFactOverrideBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  /// One override per book and fact.
  @@unique([workspaceId, bookId, factId])
  @@index([workspaceId, factId])
  @@index([createdById])
}
