// ─────────────────────────────────────────────────────────────────
//  The question engine (Phase 2.2).
//
//  An InterviewSession questions a book's bible about one element, every
//  element of one kind, or the whole book. It runs in ROUNDS: each round
//  asks the whole frontier at once (every open field whose prerequisites are
//  settled, after removing what the bible already answers), numbered; the
//  author answers, skips or defers each question; the round closes and the
//  frontier is recomputed. The pure core is `src/lib/interview/`; the
//  usecases are `src/app-layer/usecases/interview*.ts`.
//
//  EVERY MODEL HERE IS WORKSPACE-SCOPED: each has a `workspaceId`, FORCE
//  ROW LEVEL SECURITY and the `workspace_isolation` / `superuser_bypass`
//  policies in its migration, and is reached through `runInWorkspaceContext`.
//  The workspace travels in every foreign key (a session's book by
//  (workspaceId, bookId), a question's session by (workspaceId, bookId,
//  sessionId), an answer's question by (workspaceId, sessionId, questionId)),
//  and a question's element by (bookId, elementId), so the database refuses a
//  question about another book's element.
//
//  AUTHOR TEXT IS ENCRYPTED AT REST: a question's text, options, scale
//  labels, recommended answer, rationale and challenge quote (generated from
//  the author's bible, and a challenge quotes it), and an answer's text and
//  choice. They are listed in `src/lib/security/encrypted-fields.ts`; the
//  JSON-shaped ones (options, scale labels, the recommendation) are
//  serialised to a string and sealed whole. Rounds' plans and metrics, and a
//  session's stop detail, carry ids, field keys and counts only.
//
//  Answer is APPEND-ONLY: a trigger refuses UPDATE and DELETE for every role,
//  except the delete its question's cascade makes and the clearing of
//  `answeredById` when that person is deleted. A re-answer is a new row with
//  the next `revision`; the latest revision is the answer.
//
//  DIALS AND DEFAULTS (Phase 2.3). A session stores the dials it runs with
//  (depth, detail, personas, the two toggles), resolved when it starts from
//  its own request, then the book's defaults (BookInterviewDefaults), then the
//  workspace's (WorkspaceInterviewDefaults), then the code default
//  (src/lib/interview/dial-settings.ts). A defaults column left NULL passes
//  the dial on. A dial changes prompts and budgets only: nothing here is read
//  on the bible's write path.
//
//  A question's vectors (deduplication, through the 2.0 vector store) are
//  deleted with it by `vector_embedding_delete_with_source('Question')`, and a
//  vector is never written for a question that no longer exists
//  (`vector_embedding_require_source`), so a rebuild cannot bring one back.
// ─────────────────────────────────────────────────────────────────

/// One interview of a book's bible.
model InterviewSession {
  id                  String               @id @default(cuid())
  workspaceId         String
  bookId              String
  scope               InterviewScope
  /// The element a scope-ELEMENT session questions (CHECK: set exactly then).
  targetElementId     String?
  /// The kind a scope-KIND session questions (CHECK: set exactly then).
  targetKind          BibleElementKind?
  /// Phase 3.3, a SELECTION session ("Grill this" on a story map): the
  /// elements selected, and the relations in scope — those selected and those
  /// between the selected elements — frozen when it starts. Ids, not foreign
  /// keys: a scoped element or relation deleted later leaves the scope. Empty
  /// for every other scope (CHECK).
  scopeElementIds     String[]             @default([])
  scopeRelationIds    String[]             @default([])
  /// Phase 3.3, a BETWEEN session ("What happens between these?"): the kind of
  /// the element not yet created (PLOT_BEAT), the two neighbouring elements it
  /// would sit between in story order, and the act lane it would join (NULL:
  /// the beats have no act). Set exactly for BETWEEN (CHECK). Ids, not foreign
  /// keys, as above.
  slotKind            BibleElementKind?
  slotAfterElementId  String?
  slotBeforeElementId String?
  slotAct             String?
  /// Phase 4.2 (D28): "Grill me on what changed": the stale flag a SELECTION session of its one element was started from (frozen; NULL otherwise, and once the flag goes).
  staleFlagId         String?
  /// Phase 4.3 (D29): the stress test a SELECTION session was started from (its weak points ride along as a data block; NULL otherwise, and once the test goes).
  stressTestId        String?
  /// How far down the field dependencies the session goes, 1..5 (CHECK).
  depth               Int
  /// How specific a question is and how long a reply it invites, 1..5 (CHECK).
  detail              Int
  /// The persona keys mounted, in the author's order: at most three, known,
  /// no repeats (CHECK; Phase 2.3). Each words its share of every round.
  personaKeys         String[]
  offerRecommended    Boolean              @default(true)
  /// "Multiple choice where possible".
  preferChoice        Boolean              @default(false)
  status              InterviewStatus      @default(ACTIVE)
  /// Set exactly when the session is not ACTIVE (CHECK).
  stopReason          InterviewStopReason?
  /// Why, in ids and field keys: which fields wait on a deferred one, which are too deep.
  stopDetail          Json?
  /// Phase 4.4 (D23): how long the session runs: ROUNDS (`roundBudget`), QUESTIONS (`questionBudget`) or
  /// UNTIL_STOPPED (neither; the token budget, the ceiling, the kill switch and the author bound it). CHECK.
  lengthMode          InterviewLengthMode  @default(ROUNDS)
  /// The rounds a ROUNDS session runs at most (the author's number; set exactly for ROUNDS since 4.4, CHECK).
  roundBudget         Int?
  /// Phase 4.4: the questions a QUESTIONS session asks at most (set exactly for QUESTIONS, CHECK).
  questionBudget      Int?
  /// Phase 4.4 (D30): the question generators the author switched off for this session (resolved like a dial;
  /// a closed list, CHECK). A generator off proposes nothing; the others still compete on value.
  generatorsOff       String[]             @default([])
  /// Phase 4.4 (D30): the author chose to go on past the point where every remaining question was minor
  /// (VALUE_FELL); the session no longer pauses for it.
  minorAccepted       Boolean              @default(false)
  /// Rounds closed so far.
  roundsRun           Int                  @default(0)
  /// The packs the session mounted, pinned when it started (Phase 2.3): a JSON
  /// array of `{ name, version, contentHash, recordHash, recordKind }`
  /// (src/lib/interview/pack-mount.ts). WRITTEN ONCE: a trigger refuses any
  /// change after the insert. NULL: the session predates pinning (2.2).
  packPins            Json?
  /// Tokens the session may spend (input and output together); 2.1 counts `tokensUsed`.
  tokenBudget         Int
  tokensUsed          Int                  @default(0)
  /// Who started it; NULL once that person is deleted.
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Set when the session is COMPLETED or STOPPED.
  endedAt             DateTime?

  book                Book                 @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)
  targetElement       BibleElement?        @relation(fields: [bookId, targetElementId], references: [bookId, id], onDelete: Cascade)
  staleFlag           StaleFlag?           @relation(fields: [staleFlagId], references: [id], onDelete: SetNull)
  stressTest          StressTest?          @relation(fields: [stressTestId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rounds              InterviewRound[]
  questions           Question[]
  /// Phase 2.5: the rounds' reconcile runs and the proposed bible changes.
  reconcileRuns       ReconcileRun[]
  enrichmentProposals EnrichmentProposal[]
  /// Phase 4.3: the summaries of its earlier rounds (long-session compaction).
  compactions         InterviewCompaction[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, bookId, id])
  /// A book's interviews, newest first.
  @@index([workspaceId, bookId, createdAt])
  @@index([bookId, targetElementId])
  @@index([createdById])
  /// Phase 4.2: a stale flag's grill sessions (the foreign key's SET NULL).
  @@index([staleFlagId])
  /// Phase 4.3: a stress test's sessions (the foreign key's SET NULL).
  @@index([stressTestId])
}

/// One round of a session: the frontier it was planned from and the
/// questions it asked.
model InterviewRound {
  id            String               @id @default(cuid())
  workspaceId   String
  sessionId     String
  /// 1, 2, 3, … per session (unique).
  number        Int
  status        InterviewRoundStatus @default(GENERATING)
  /// The plan: frontier, targets, carried fields, challenge, persona
  /// assignments — field references and levels, no text.
  plan          Json
  /// What generation did: candidates, drops by reason, pack fallbacks, carried fields.
  metrics       Json?
  /// The question-generation prompt's version (roadmap rule 9).
  promptVersion String
  startedAt     DateTime             @default(now())
  openedAt      DateTime?
  closedAt      DateTime?

  session             InterviewSession     @relation(fields: [workspaceId, sessionId], references: [workspaceId, id], onDelete: Cascade)
  questions           Question[]
  /// Phase 2.5: the round's reconcile run, once it closed, and its proposals.
  reconcileRun        ReconcileRun?
  enrichmentProposals EnrichmentProposal[]

  @@unique([sessionId, number])
  @@unique([sessionId, id])
  @@index([workspaceId, sessionId])
}

/// One question asked in a round.
model Question {
  id                   String         @id @default(cuid())
  workspaceId          String
  bookId               String
  sessionId            String
  roundId              String
  /// Its number within the round, from 1.
  position             Int
  /// The element it asks about. For a question about a relation (Phase 3.3),
  /// the relation's declaring element; for one about a BETWEEN session's
  /// element not yet created, the slot's earlier neighbour, its anchor (a
  /// question names an element of the book; `aboutPending` says it is not
  /// about this one).
  elementId            String
  /// Phase 3.3 (D24): the relation whose fields it targets, or NULL.
  relationId           String?
  /// Phase 3.3: it asks about the BETWEEN session's element not yet created
  /// (CHECK: never with a relation).
  aboutPending         Boolean        @default(false)
  /// The one or two fields of that element it targets (CHECK).
  targetsFieldKeys     String[]
  mode                 QuestionMode
  origin               QuestionOrigin
  /// The persona that worded it; NULL for a pack fallback or a session with none.
  personaKey           String?
  kind                 QuestionKind
  /// The question (encrypted).
  text                 String
  /// CHOICE and EITHER_OR options, a JSON array (encrypted).
  options              String?
  /// SCALE anchors, JSON `{ low, high }` (encrypted).
  scaleLabels          String?
  /// The recommended answer, JSON: an option, 1..5 or text (encrypted).
  recommendedAnswer    String?
  /// What the recommendation rests on: `{ fieldKeys, answerIds }`, no text.
  recommendationBasis  Json?
  /// Why it is asked (encrypted).
  rationale            String?
  /// A CHALLENGE's verbatim quote of the stored value (encrypted).
  challengeQuote       String?
  /// The questions whose answers settled this question's prerequisites (derived; display and audit).
  dependsOnQuestionIds String[]
  /// Keyed hash of the normalised text (`questionDedupeKey`): exact repeats across the book, no text.
  dedupeKey            String
  /// The question this one replaces: the author asked "Ask me this
  /// differently" (Phase 2.4). Same session and round, same targets; one
  /// rephrase per question (unique), which may itself be rephrased.
  replacesQuestionId   String?
  /// Set when a rephrase replaced this question: it is no longer asked and
  /// cannot be answered (only one of the pair is). Never cleared.
  supersededAt         DateTime?
  /// The guard flagged the model call that worded it and let the call go on
  /// ("flag and fence", 2.1): the question is asked, with a visible marker.
  reviewRequired       Boolean        @default(false)
  /// Phase 4.4 (D30): the generator that proposed it (the frontier, the deepening ladder, relations, source
  /// questions, continuity). Codes, never text.
  generator            QuestionGenerator @default(FRONTIER)
  /// Phase 4.4: a ladder question's layer (WHAT, WHY, COST, WHO_KNOWS, BREAKS, EDGE_CASES) or a pair question's
  /// angle (WANTS, COLLIDE, HIDDEN). CHECK: a closed list, only on LADDER and RELATIONS.
  angle                String?
  /// Phase 4.4 (D30): a RELATIONS question about two elements with no relation yet: the other element (the
  /// first is `elementId`). Its answer may lead to a NEW_RELATION proposal through 2.5/3.3's reconcile.
  pairElementId        String?
  /// Phase 4.4 (D30): a SOURCES question's fact: answering yes confirms it, no rejects it, when the round closes.
  storyFactId          String?
  /// Phase 4.4: what a CONTINUITY question rests on, by id (`proposal:<id>`, `thread:<id>`, `gap:<elementId>`).
  continuityRef        String?
  /// Phase 4.4 (D30): the code's value score when it was asked (0..100): how much new information it adds.
  valueScore           Int?
  createdAt            DateTime       @default(now())

  session    InterviewSession @relation(fields: [workspaceId, bookId, sessionId], references: [workspaceId, bookId, id], onDelete: Cascade)
  round      InterviewRound   @relation(fields: [sessionId, roundId], references: [sessionId, id], onDelete: Cascade)
  element    BibleElement     @relation(fields: [bookId, elementId], references: [bookId, id], onDelete: Cascade)
  relation   BibleRelation?   @relation(fields: [bookId, relationId], references: [bookId, id], onDelete: Cascade)
  replaces   Question?        @relation("QuestionRephrase", fields: [workspaceId, sessionId, replacesQuestionId], references: [workspaceId, sessionId, id], onDelete: Cascade)
  replacedBy Question?        @relation("QuestionRephrase")
  answers    Answer[]
  pairElement BibleElement?   @relation("QuestionPairElement", fields: [bookId, pairElementId], references: [bookId, id], onDelete: Cascade)
  storyFact  StoryFact?       @relation("QuestionStoryFact", fields: [storyFactId], references: [id], onDelete: SetNull)

  @@unique([roundId, position])
  @@unique([workspaceId, sessionId, id])
  /// One rephrase per question (and the foreign key's index).
  @@unique([workspaceId, sessionId, replacesQuestionId])
  /// An element's questions across the book's sessions (book-wide deduplication).
  @@index([bookId, elementId, createdAt])
  /// Phase 3.3: a relation's questions across the book's sessions (the same).
  @@index([bookId, relationId, createdAt])
  /// Exact repeats anywhere in the book.
  @@index([workspaceId, bookId, dedupeKey])
  /// Phase 4.4: a pair's questions (and the foreign key's index).
  @@index([bookId, pairElementId])
  /// Phase 4.4: the questions that asked about a fact (the foreign key's SET NULL).
  @@index([storyFactId])
}

/// What the author did with a question. Append-only (trigger): a re-answer
/// is a new row with the next revision.
model Answer {
  id                     String       @id @default(cuid())
  workspaceId            String
  sessionId              String
  questionId             String
  /// 1, 2, 3, … per question; the highest is the answer.
  revision               Int
  status                 AnswerStatus
  /// OPEN and SCENARIO replies, and the reason given with a pick (encrypted).
  text                   String?
  /// The option picked for CHOICE and EITHER_OR (encrypted).
  choice                 String?
  /// The number picked for SCALE, 1..5 (CHECK).
  scale                  Int?
  /// The author took the recommended answer as it was offered.
  acceptedRecommendation Boolean      @default(false)
  /// Who answered; NULL once that person is deleted.
  answeredById           String?
  createdAt              DateTime     @default(now())

  question   Question             @relation(fields: [workspaceId, sessionId, questionId], references: [workspaceId, sessionId, id], onDelete: Cascade)
  answeredBy User?                @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  /// Phase 2.5: the proposals drawn from this answer.
  citations  EnrichmentCitation[]
  /// Phase 4.4: the source facts this answer decided.
  factDecisions StoryFact[]       @relation("StoryFactDecidedByAnswer")

  @@unique([questionId, revision])
  /// An answer by id within its session: what a citation's foreign key names (Phase 2.5).
  @@unique([workspaceId, sessionId, id])
  @@index([workspaceId, sessionId, questionId])
  @@index([answeredById])
}

/// A workspace's interview defaults (Phase 2.3): each dial set, or NULL to
/// pass it on to the code default. One row per workspace.
model WorkspaceInterviewDefaults {
  workspaceId      String   @id
  /// 1..5 (CHECK), or NULL.
  depth            Int?
  /// 1..5 (CHECK), or NULL.
  detail           Int?
  /// A JSON array of at most three known persona keys, no repeats (CHECK), or NULL.
  /// `[]` is a setting: no persona.
  personaKeys      Json?
  offerRecommended Boolean?
  preferChoice     Boolean?
  /// Phase 4.4 (D30): a JSON array of the question generators switched off (a closed list, CHECK), or NULL.
  /// `[]` is a setting: every generator on.
  generatorsOff    Json?
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A book's interview defaults (Phase 2.3): each dial set, or NULL to pass it
/// on to the workspace's default. One row per book.
model BookInterviewDefaults {
  bookId           String   @id
  workspaceId      String
  depth            Int?
  detail           Int?
  personaKeys      Json?
  offerRecommended Boolean?
  preferChoice     Boolean?
  /// Phase 4.4 (D30): a JSON array of the question generators switched off (a closed list, CHECK), or NULL.
  /// `[]` is a setting: every generator on.
  generatorsOff    Json?
  updatedAt        DateTime @updatedAt

  book Book @relation(fields: [workspaceId, bookId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, bookId])
}
