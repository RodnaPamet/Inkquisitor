node_modules/

# Next.js
.next/
out/
next_error*.html

# Environment files (secrets): every .env* file is ignored except the
# committed template, the same pattern as .dockerignore. Enumerating names
# left .env.development (which `next dev` loads) committable.
.env*
!.env.example

