# ─── Docker build context exclusions ─────────────────────────
# Keep the build context small and fast.

# Version control
.git
.gitignore

# CI/CD
.github

# Dependencies (installed in-container)
node_modules

# Build output (rebuilt in-container)
.next
out

# Tests
tests/
# Co-located test folders (eslint-rules/__tests__, src/**/__tests__, packages/ui/**/__tests__)
# import tests/helpers, which is not in the context; next build type-checks every
# file tsconfig includes, so one of them here fails the image build.
**/__tests__/
test-results/
playwright-report/
coverage/
jest.config.*
jest.setup.*
playwright.config.*

# Dev tooling
.vscode/
.idea/
.claude/

# Documentation
docs/
README.md

# Environment files (secrets — never bake into image)
.env*
!.env.example

# Docker-compose (not needed inside image)
docker-compose*.yml

# Temporary artifacts
*.log
tmp/

# The docs site and its install, and the worker bundle (rebuilt in-container)
site/
# The release tooling (.github/workflows/release.yml), never part of the app
release/
dist/
.husky/
